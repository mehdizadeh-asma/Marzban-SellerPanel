{
  "name": "marzban-seller-panel",
  "version": "2.5.9",
  "description": "Marzban Seller Panel",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon -L dist/app.js",
    "build-dev": "tsc -w",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test-coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ..",
    "check": "npm run lint"
  },
  "dependencies": {
    "axios": "1.13.2",
    "cors": "2.8.5",
    "express": "5.2.1",
    "mongoose": "8.20.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "1.19.5",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.12",
    "@types/node": "22.10.1",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "eslint": "9.16.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-unused-imports": "3.1.0",
    "jest": "29.7.0",
    "lint-staged": "15.2.9",
    "nodemon": "3.1.7",
    "prettier": "3.3.3",
    "prettier-plugin-organize-imports": "4.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
