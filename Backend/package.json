{
  "name": "marzban-seller-panel",
  "version": "2.5.9",
  "description": "Marzban Seller Panel",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon -L dist/app.js",
    "build-dev": "tsc -w",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test-coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "npm run lint"
  },
  "dependencies": {
    "axios": "1.13.2",
    "cors": "2.8.5",
    "express": "5.2.1",
    "mongoose": "8.20.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@types/uuid": "^11",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
