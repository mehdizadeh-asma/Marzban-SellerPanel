{
  "name": "marzban-seller-panel",
  "version": "2.5.7",
  "description": "Marzban Seller Panel",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon -L dist/app.js",
    "build-dev": "tsc -w",
    "start": "node dist/app.js",
    "build": "tsc",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write",
      "eslint --fix",
      "jest"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mehdizadeh-asma/Marzban-SellerPanel.git"
  },
  "keywords": [
    "marzban",
    "seller",
    "panel"
  ],
  "author": "Asmein",
  "license": "ISC",
  "dependencies": {
    "axios": "^1",
    "body-parser": "^2",
    "cors": "^2",
    "express": "^5",
    "mongoose": "^8",
    "uuid": "^13"
  },
  "devDependencies": {
    "@types/body-parser": "^1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@types/uuid": "^10",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.6",
    "nodemon": "^3",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
